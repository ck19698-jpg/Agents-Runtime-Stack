# =============================================================================
# AGENTS RUNTIME STACK - PER TEAM ENVIRONMENT TEMPLATE
# Copy to: $HOME/teams/<team-slug>/.env
# Never commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Team identity and paths
# -----------------------------------------------------------------------------
TEAM_SLUG=lastcore-agency
COMPOSE_PROJECT_NAME=agents-lastcore-agency
TEAM_ROOT=/home/lastcore/teams/lastcore-agency
TEAM_SHARED_DIR=/home/lastcore/teams/lastcore-agency/shared
TZ=Asia/Bangkok

# -----------------------------------------------------------------------------
# OpenClaw runtime
# -----------------------------------------------------------------------------
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_HOST_PORT=18789
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=0

OPENCLAW_CONFIG_DIR=/home/lastcore/teams/lastcore-agency/.openclaw
OPENCLAW_WORKSPACE_DIR=/home/lastcore/teams/lastcore-agency/shared
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/home/lastcore/teams/lastcore-agency/.openclaw-auth-profile-secrets

# Generated automatically by scripts/create-team.sh
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
GOG_KEYRING_PASSWORD=CHANGE_ME

# Comma-separated origins only when Control UI is intentionally exposed.
GATEWAY_CONTROLUI_ALLOWEDORIGINS=

# -----------------------------------------------------------------------------
# Pi Operator and Hermes state
# -----------------------------------------------------------------------------
PI_STATE_DIR=/home/lastcore/teams/lastcore-agency/.pi/agent
HERMES_STATE_DIR=/home/lastcore/teams/lastcore-agency/.hermes

# -----------------------------------------------------------------------------
# Cloud model providers
# Leave unused providers blank.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
OPENCODE_API_KEY=
COPILOT_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
AI_GATEWAY_API_KEY=
SYNTHETIC_API_KEY=
MINIMAX_API_KEY=
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# Local llama.cpp / LlamaBarn
# OpenClaw runs in Docker, so use host.docker.internal for a model on the host.
# -----------------------------------------------------------------------------
LLAMACPP_BASE_URL=http://host.docker.internal:8080/v1
LLAMACPP_API_KEY=dummy
LLAMACPP_MODEL_ID=
LLAMACPP_MODEL_NAME=
LLAMACPP_CONTEXT_WINDOW=32768
LLAMACPP_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Local Ollama
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=ollama-local
OLLAMA_MODEL_ID=
OLLAMA_MODEL_NAME=

# -----------------------------------------------------------------------------
# ModelArk / BytePlus
# -----------------------------------------------------------------------------
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MODELARK_API_KEY=

# -----------------------------------------------------------------------------
# Typhoon
# -----------------------------------------------------------------------------
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_API_KEY=

# -----------------------------------------------------------------------------
# Telegram command center
# One group chat, one topic and token per canonical agent.
# -----------------------------------------------------------------------------
TELEGRAM_COMMAND_CENTER_CHAT_ID=

TELEGRAM_SIRIUS_TOKEN=
TELEGRAM_SIRIUS_TOPIC_ID=

TELEGRAM_DRACO_TOKEN=
TELEGRAM_DRACO_TOPIC_ID=

TELEGRAM_POLARIS_TOKEN=
TELEGRAM_POLARIS_TOPIC_ID=

TELEGRAM_ANTARES_TOKEN=
TELEGRAM_ANTARES_TOPIC_ID=

TELEGRAM_ALTAIR_TOKEN=
TELEGRAM_ALTAIR_TOPIC_ID=

TELEGRAM_CAPELLA_TOKEN=
TELEGRAM_CAPELLA_TOPIC_ID=

# Optional legacy single-bot fallback
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# LINE channels
# Each agent has its own channel ID, access token and secret.
# Do not reuse LINE_CHANNEL_ID because duplicate .env keys overwrite each other.
# -----------------------------------------------------------------------------
LINE_SIRIUS_CHANNEL_ID=
LINE_SIRIUS_CHANNEL_ACCESS_TOKEN=
LINE_SIRIUS_CHANNEL_SECRET=

LINE_DRACO_CHANNEL_ID=
LINE_DRACO_CHANNEL_ACCESS_TOKEN=
LINE_DRACO_CHANNEL_SECRET=

LINE_POLARIS_CHANNEL_ID=
LINE_POLARIS_CHANNEL_ACCESS_TOKEN=
LINE_POLARIS_CHANNEL_SECRET=

LINE_ANTARES_CHANNEL_ID=
LINE_ANTARES_CHANNEL_ACCESS_TOKEN=
LINE_ANTARES_CHANNEL_SECRET=

LINE_ALTAIR_CHANNEL_ID=
LINE_ALTAIR_CHANNEL_ACCESS_TOKEN=
LINE_ALTAIR_CHANNEL_SECRET=

LINE_CAPELLA_CHANNEL_ID=
LINE_CAPELLA_CHANNEL_ACCESS_TOKEN=
LINE_CAPELLA_CHANNEL_SECRET=
